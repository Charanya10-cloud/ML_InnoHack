# Postgres
POSTGRES_USER=repurpose
POSTGRES_PASSWORD=repurpose
POSTGRES_DB=repurpose
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Built automatically from the above if DATABASE_URL is not set directly
DATABASE_URL=postgresql://repurpose:repurpose@db:5432/repurpose

# External APIs (ClinicalTrials.gov + bioRxiv + PubMed E-utilities are free,
# but NCBI wants an email/API key to raise rate limits)
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# Comma-separated disease areas to focus ingestion on (Day 1 scope)
DISEASE_FOCUS_AREAS=Alzheimer's disease,Type 2 diabetes,Non-small cell lung cancer

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
